# Next.js / Vercel
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never prefix a service key with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase Edge Functions: set these separately in Edge secrets.
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected by hosted Supabase Edge.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
SCHEDULER_SECRET=

# Optional, used only by the webhook registration script.
TELEGRAM_WEBHOOK_URL=

# Optional AI classroom-note organization (Vercel server only). Rules mode works without these.
OPENAI_API_KEY=
OPENAI_NOTES_MODEL=gpt-4.1-mini
